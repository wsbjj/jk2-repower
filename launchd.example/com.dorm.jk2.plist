<?xml version="1.0" encoding="UTF-8"?>
<!--
  JK-2 复电守护模板：开机自动启动，崩溃自动重启
  __PROJECT_DIR__ / __DEV_TOKEN__ / __PYTHON__ 由 ./run.sh install 渲染
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dorm.jk2</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__PROJECT_DIR__/ble/jk2.py</string>
        <string>watch</string>
        <string>--token</string>
        <string>__DEV_TOKEN__</string>
        <string>--interval</string>
        <string>600</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>PRIVATE_DIR</key>
        <string>__PROJECT_DIR__/private</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/private/logs/jk2.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/private/logs/jk2.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
