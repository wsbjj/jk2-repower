<?xml version="1.0" encoding="UTF-8"?>
<!--
  JK-2 定点复电模板：每天跑 2 次，不常驻
  __PROJECT_DIR__ / __DEV_TOKEN__ / __PYTHON__ 由 ./run.sh install-daily 渲染

  安装：
    ./run.sh install-daily
  查看：
    launchctl list | grep jk2daily
  卸载：
    ./run.sh uninstall-daily
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dorm.jk2daily</string>

    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>__PROJECT_DIR__/ble/jk2.py</string>
        <string>recover</string>
        <string>--token</string>
        <string>__DEV_TOKEN__</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>PRIVATE_DIR</key>
        <string>__PROJECT_DIR__/private</string>
    </dict>

    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key><integer>6</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
        <dict>
            <key>Hour</key><integer>22</integer>
            <key>Minute</key><integer>0</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/private/logs/jk2-daily.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/private/logs/jk2-daily.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
