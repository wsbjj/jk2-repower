{
  "_comment": "配置模板 → 复制到 private/config/config.json 后填真值。private/ 不进仓库。重点核对 baseUrl / appid / sign.secret / api 三件套。",
  "baseUrl": "https://dorm.example.com",
  "appid": "wxXXXXXXXXXXXXXXXX",
  "roomNo": "301",
  "sign": {
    "type": "md5",
    "template": "{sortedParams}&ts={ts}&k={secret}",
    "secret": "FILL_FROM_REVERSED_JS",
    "placement": "header",
    "headerName": "X-Sign",
    "sendTs": true,
    "sendNonce": false
  },
  "headers": {
    "content-type": "application/json",
    "user-agent": "Mozilla/5.0 (iPhone; CPU iPhone OS 15_8 like Mac OS X) AppleWebKit/605.1.15 MicroMessenger/8.0.49",
    "Referer": "https://servicewechat.com/{appid}/0/page-frame.html"
  },
  "api": {
    "login": "/api/dorm/auth/login",
    "roomInfo": "/api/dorm/room/info",
    "recover": "/api/dorm/power/recover"
  },
  "okCode": 0,
  "verify": { "enabled": true, "retries": 8, "intervalMs": 1500 },
  "retry": { "times": 3, "backoffMs": 800 },
  "jitterMs": 1200,
  "timeoutMs": 10000
}
